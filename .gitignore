# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Large artefacts. Not in git; see docs/reproduce.md for how to obtain them.
# ---------------------------------------------------------------------------
# ARQMath-3 collection, derived representations and built indexes (~31 GB)
data/
# Judge response cache
.cache/
# Weights & Biases local logs (W&B is a mirror; local result files are canonical)
wandb/
# Retrieval run files and generation outputs (~210 MB)
results/
# Working run directory
experiments/runs/

# ---------------------------------------------------------------------------
# Thesis. The LaTeX sources and the compiled report are published. Not
# published: the literature PDFs (copyright), the author's scanned
# signature, dated snapshots, the defence deck, the expose, and LaTeX
# build output.
# ---------------------------------------------------------------------------
thesis/*
!thesis/report-tex/
!thesis/thesis-report.pdf

# Scanned signature, rendered onto the declaration page by softlang.cls.
# Not published. A blank PNG at this path lets the build run.
thesis/report-tex/images/abram_jopaul_signature.png

# LaTeX build output and section previews
thesis/report-tex/*.aux
thesis/report-tex/*.bbl
thesis/report-tex/*.bcf
thesis/report-tex/*.blg
thesis/report-tex/*.fdb_latexmk
thesis/report-tex/*.fls
thesis/report-tex/*.lof
thesis/report-tex/*.log
thesis/report-tex/*.lot
thesis/report-tex/*.out
thesis/report-tex/*.run.xml
thesis/report-tex/*.toc
thesis/report-tex/*.synctex.gz
thesis/report-tex/ausarbeitung.pdf
thesis/report-tex/_sec*_preview.pdf
thesis/report-tex/doi-lookup-list.txt

# ---------------------------------------------------------------------------
# Dated snapshots of working documents — local history, not repo history
# ---------------------------------------------------------------------------
*.bak.*
*.preWritten.*

# ---------------------------------------------------------------------------
# Pre-publication backups and loose patches
# ---------------------------------------------------------------------------
_pre-publication-backup/
*.bundle
*.patch

# ---------------------------------------------------------------------------
# Assistant working notes
# ---------------------------------------------------------------------------
Claude outputs/
CLAUDE.md
CLAUDE.*.md

# ---------------------------------------------------------------------------
# Environments and editors
# ---------------------------------------------------------------------------
.venv/
.vscode/
.cursor/

# ---------------------------------------------------------------------------
# Build and runtime cruft
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.egg-info/
artifacts/
media/
hs_err_pid*.log
cuda_installer.pyz

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store

# Reference copy of upstream TangentCFT, not a dependency.
# src/multirag/formula_search/ holds the adapted ports actually used.
external/
